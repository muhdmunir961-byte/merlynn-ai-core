NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
BOT_NAME=Merlynn

# AI Core personality / brain
# Any OpenAI-compatible endpoint works (Ollama, llama.cpp, vLLM, router).
LLM_BASE_URL=
LLM_API_KEY=
LLM_FAST_MODEL=
LLM_SMART_MODEL=
LLM_FALLBACK_URL=
LLM_TIMEOUT_MS=45000

# Bridge to the WhatsApp bot running on Pterodactyl
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=

# Commerce
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=

# Dashboard protection
DASHBOARD_SECRET=

# Memory store (facts, preferences, learned notes)
MEMORY_FILE=./data/memory.json
